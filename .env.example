# Google Colab Integration (Optional)
# The Colab VS Code extension's public OAuth credentials are used by default.
# Only set these if you want to use your own OAuth2 client instead.
# Create OAuth2 desktop credentials at https://console.cloud.google.com/apis/credentials
# with the scope: https://www.googleapis.com/auth/colaboratory
# COLAB_CLIENT_ID=
# COLAB_CLIENT_SECRET=
